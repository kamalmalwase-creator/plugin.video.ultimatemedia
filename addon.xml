<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.ultimatemedia"
       name="Ultimate Media Hub"
       version="1.0.0"
       provider-name="Ultimate Media">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.pluginsource"
               library="addon.py">
        <provides>video</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Ultimate Media Hub</summary>
        <description lang="en_GB">
            Movies, Series, Live TV and IPTV
        </description>
        <platform>all</platform>
        <license>MIT</license>
    </extension>

</addon>
